<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Seiri.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="RailBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TilePlaceholderBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="PreviewPaneBackgroundBrush" Color="#F9F9F9" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="RailBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TilePlaceholderBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="PreviewPaneBackgroundBrush" Color="#1C1C1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="RailBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TilePlaceholderBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PreviewPaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <x:Double x:Key="RailCompactWidth">48</x:Double>
            <x:Double x:Key="RailExpandedWidth">240</x:Double>
            <x:Double x:Key="PreviewPaneWidth">320</x:Double>
            <CornerRadius x:Key="TileCornerRadius">4</CornerRadius>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" xmlns:local="using:Seiri" />
            <local:BoolToHorizontalAlignmentConverter x:Key="BoolToAlignConverter" xmlns:local="using:Seiri" />

            <Style TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style
                x:Key="ChromeIconButtonStyle"
                BasedOn="{StaticResource SubtleButtonStyle}"
                TargetType="Button">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <Style
                x:Key="RailButtonStyle"
                BasedOn="{StaticResource SubtleButtonStyle}"
                TargetType="Button">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
