<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Seiri.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Seiri"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Seiri.Core.Models"
    xmlns:views="using:Seiri.Views"
    Title="Seiri"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Seiri"
            IsBackButtonVisible="{x:Bind ViewModel.IsSettingsOpen, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            BackRequested="OnBackRequested"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <views:SearchBox
                    x:Name="GallerySearch"
                    MinWidth="280"
                    MaxWidth="720"
                    HorizontalAlignment="Stretch" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="AddFolderButton"
                        AutomationProperties.AutomationId="BtnAddFolders"
                        AutomationProperties.Name="Add folders"
                        Click="OnAddFolderClick"
                        CornerRadius="4"
                        Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock VerticalAlignment="Center" Text="Add folders" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.AutomationId="BtnSettings"
                        AutomationProperties.Name="Settings"
                        Click="OnSettingsClick"
                        Style="{StaticResource ChromeIconButtonStyle}">
                        <FontIcon Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="Rail"
                Width="{x:Bind ViewModel.RailWidth, Mode=OneWay}"
                Background="{ThemeResource RailBackgroundBrush}"
                Padding="4,4">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">
                        <Button
                            AutomationProperties.AutomationId="NavAll"
                            Style="{StaticResource RailButtonStyle}"
                            Click="OnNavAll"
                            ToolTipService.ToolTip="All media">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind local:MainWindow.NavPill(ViewModel.CurrentSection, 0), Mode=OneWay}"
                                    CornerRadius="4" />
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Glyph="&#xE91B;" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Text="All media"
                                    Visibility="{x:Bind local:MainWindow.BoolToVis(ViewModel.RailExpanded), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="NavFavorites"
                            Style="{StaticResource RailButtonStyle}"
                            Click="OnNavFavorites"
                            ToolTipService.ToolTip="Favorites">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind local:MainWindow.NavPill(ViewModel.CurrentSection, 1), Mode=OneWay}"
                                    CornerRadius="4" />
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Glyph="&#xEB52;" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Text="Favorites"
                                    Visibility="{x:Bind local:MainWindow.BoolToVis(ViewModel.RailExpanded), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="NavTagging"
                            Style="{StaticResource RailButtonStyle}"
                            Click="OnNavTagging"
                            ToolTipService.ToolTip="Tagging">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind local:MainWindow.NavPill(ViewModel.CurrentSection, 2), Mode=OneWay}"
                                    CornerRadius="4" />
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Glyph="&#xE8EC;" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Text="Tagging"
                                    Visibility="{x:Bind local:MainWindow.BoolToVis(ViewModel.RailExpanded), Mode=OneWay}" />
                            </Grid>
                        </Button>

                        <MenuFlyoutSeparator Margin="8,8" />

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Libraries, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:LibraryInfo">
                                    <Button
                                        Style="{StaticResource RailButtonStyle}"
                                        Click="OnLibraryButtonClick"
                                        Tag="{x:Bind RootPath}"
                                        ToolTipService.ToolTip="{x:Bind RootPath}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Glyph="&#xE8B7;" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind DisplayName}"
                                                Visibility="{Binding DataContext.RailExpanded, ElementName=RootGrid, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <views:GalleryPage
                x:Name="GalleryHost"
                Grid.Column="1"
                Visibility="{x:Bind local:MainWindow.NotBoolToVis(ViewModel.IsSettingsOpen), Mode=OneWay}" />

            <views:SettingsPage
                x:Name="SettingsHost"
                Grid.Column="1"
                Visibility="{x:Bind local:MainWindow.BoolToVis(ViewModel.IsSettingsOpen), Mode=OneWay}" />

            <views:PreviewPane
                x:Name="PreviewHost"
                Grid.Column="2"
                Width="320"
                Visibility="{x:Bind local:MainWindow.PreviewVis(ViewModel.IsPreviewOpen, ViewModel.IsSettingsOpen), Mode=OneWay}" />
        </Grid>

        <Grid
            x:Name="SearchSuggestLayer"
            Grid.Row="1"
            Canvas.ZIndex="20"
            Visibility="{x:Bind local:MainWindow.BoolToVis(ViewModel.Gallery.SuggestionsOpen), Mode=OneWay}">
            <Border Background="Transparent" PointerPressed="OnSearchDismissPointer" />
            <Border
                x:Name="SearchSuggestPanel"
                MinWidth="280"
                MaxHeight="420"
                Margin="0,4,0,0"
                Padding="0,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8"
                PointerPressed="OnSuggestPanelPointer">
                <ListView
                    x:Name="SearchSuggestList"
                    AutomationProperties.AutomationId="LstSearchSuggest"
                    MaxHeight="400"
                    BorderThickness="0"
                    IsItemClickEnabled="True"
                    ItemClick="OnSearchSuggestionClick"
                    ItemsSource="{x:Bind ViewModel.Gallery.Suggestions, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchSuggestion">
                            <Grid
                                Padding="4,6"
                                ColumnSpacing="12"
                                AutomationProperties.Name="{x:Bind Label, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Label, Mode=OneWay}" TextWrapping="NoWrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Detail, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind Kind, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Canvas.ZIndex="30"
            VerticalAlignment="Bottom"
            Margin="16"
            IsClosable="True"
            IsOpen="{x:Bind local:MainWindow.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </Grid>
</Window>
