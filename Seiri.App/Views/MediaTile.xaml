<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Seiri.Views.MediaTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{ThemeResource TilePlaceholderBrush}"
        CornerRadius="{StaticResource TileCornerRadius}">
        <Grid>
            <Image
                x:Name="ThumbImage"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Stretch="UniformToFill" />
            <Border
                x:Name="SelectChrome"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="3"
                CornerRadius="{StaticResource TileCornerRadius}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
            <Grid
                x:Name="SelectMark"
                Width="24"
                Height="24"
                Margin="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Ellipse
                    x:Name="SelectCircle"
                    Fill="#99000000"
                    Stroke="White"
                    StrokeThickness="2" />
                <FontIcon
                    x:Name="SelectCheck"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="White"
                    Glyph="&#xE73E;"
                    Visibility="Collapsed" />
            </Grid>
            <InfoBadge
                x:Name="TagBadge"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="8" />
            <Border
                x:Name="VideoMark"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="8"
                Padding="6,2"
                CornerRadius="4"
                Background="#99000000"
                Visibility="Collapsed">
                <FontIcon FontSize="12" Foreground="White" Glyph="&#xE714;" />
            </Border>
        </Grid>
    </Border>
</UserControl>
