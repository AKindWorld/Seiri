<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Seiri.Views.SearchBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Seiri.Views">

    <!--
        AutoSuggestBox is used only for the search chrome (query icon, pill).
        Its own Popup is never opened — suggestions render in MainWindow so they
        can light-dismiss. TitleBar-hosted popups do not dismiss on click/Esc.
    -->
    <Grid>
        <AutoSuggestBox
            x:Name="QueryBox"
            AutomationProperties.AutomationId="TxtSearch"
            Padding="0,0,76,0"
            PlaceholderText="Search in Gallery"
            QueryIcon="Find"
            UpdateTextOnSelect="False"
            Text="{x:Bind Gallery.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="OnTextChanged"
            QuerySubmitted="OnQuerySubmitted"
            GotFocus="OnGotFocus"
            LostFocus="OnLostFocus"
            PreviewKeyDown="OnPreviewKeyDown" />
        <Button
            Width="32"
            Height="32"
            Margin="0,0,36,0"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="BtnClearSearch"
            AutomationProperties.Name="Clear search"
            Click="OnClearSearch"
            Style="{StaticResource SubtleButtonStyle}"
            ToolTipService.ToolTip="Clear search"
            Visibility="{x:Bind local:SearchBox.BoolVis(Gallery.HasQuery), Mode=OneWay}">
            <FontIcon FontSize="14" Glyph="&#xE711;" />
        </Button>
        <TeachingTip
            x:Name="SearchTip"
            Title="Search by tag"
            Subtitle="Type a tag name, or tag: for filters. Suggestions appear below the search box."
            CloseButtonContent="Got it"
            PreferredPlacement="Bottom"
            Target="{x:Bind QueryBox}"
            Closed="OnSearchTipClosed" />
    </Grid>
</UserControl>
