<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Seiri.Views.GalleryPage"
    x:Name="Self"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Seiri.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:layouts="using:Seiri.Layouts"
    xmlns:models="using:Seiri.Core.Models"
    xmlns:vm="using:Seiri.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <local:GalleryTemplateSelector x:Key="GallerySelector">
            <local:GalleryTemplateSelector.HeaderTemplate>
                <DataTemplate x:DataType="models:GalleryEntry">
                    <TextBlock
                        Margin="0,12,0,4"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind Header}" />
                </DataTemplate>
            </local:GalleryTemplateSelector.HeaderTemplate>
            <local:GalleryTemplateSelector.TileTemplate>
                <DataTemplate x:DataType="models:GalleryEntry">
                    <local:MediaTile Item="{x:Bind Item, Mode=OneWay}" />
                </DataTemplate>
            </local:GalleryTemplateSelector.TileTemplate>
        </local:GalleryTemplateSelector>
    </Page.Resources>

    <Grid Padding="24,16,24,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Glyph="{x:Bind Gallery.HeaderGlyph, Mode=OneWay}" />
                    <TextBlock
                        x:Name="PageTitleText"
                        AutomationProperties.AutomationId="TxtPageTitle"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{x:Bind Gallery.HeaderTitle, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Margin="24,2,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Gallery.CurrentGroupLabel, Mode=OneWay}"
                    Visibility="{x:Bind local:GalleryPage.BoolVis(Gallery.ShowGroupCaption), Mode=OneWay}" />
                <TextBlock
                    Margin="24,2,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Gallery.HeaderDetail, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind local:GalleryPage.BoolVis(Gallery.HasHeaderDetail), Mode=OneWay}" />
                <TextBlock
                    x:Name="SubtitleText"
                    AutomationProperties.AutomationId="TxtSubtitle"
                    Margin="24,2,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Gallery.Subtitle, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Top">
                <ToggleButton
                    AutomationProperties.AutomationId="BtnSelect"
                    Command="{x:Bind Gallery.ToggleSelectModeCommand}"
                    CornerRadius="4"
                    IsChecked="{x:Bind Gallery.IsSelectMode, Mode=OneWay}"
                    MinHeight="36"
                    Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73A;" />
                        <TextBlock Text="Select" />
                    </StackPanel>
                </ToggleButton>

                <Button AutomationProperties.AutomationId="BtnMediaType" AutomationProperties.Name="Media type" Style="{StaticResource ChromeIconButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetKindCommand}" CommandParameter="All" GroupName="Kind" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.KindFilter, 'All'), Mode=OneWay}" Text="Photos &amp; videos" />
                            <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetKindCommand}" CommandParameter="Images" GroupName="Kind" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.KindFilter, 'Images'), Mode=OneWay}" Text="Photos" />
                            <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetKindCommand}" CommandParameter="Videos" GroupName="Kind" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.KindFilter, 'Videos'), Mode=OneWay}" Text="Videos" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE714;" />
                </Button>

                <Button AutomationProperties.AutomationId="BtnSort" AutomationProperties.Name="Sort" Style="{StaticResource ChromeIconButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetSortCommand}" CommandParameter="DateTaken" GroupName="Sort" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.Sort, 'DateTaken'), Mode=OneWay}" Text="Date taken" />
                            <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetSortCommand}" CommandParameter="DateAdded" GroupName="Sort" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.Sort, 'DateAdded'), Mode=OneWay}" Text="Date added" />
                            <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetSortCommand}" CommandParameter="DateModified" GroupName="Sort" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.Sort, 'DateModified'), Mode=OneWay}" Text="Date modified" />
                            <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetSortCommand}" CommandParameter="Name" GroupName="Sort" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.Sort, 'Name'), Mode=OneWay}" Text="Name" />
                            <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetSortCommand}" CommandParameter="Size" GroupName="Sort" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.Sort, 'Size'), Mode=OneWay}" Text="Size" />
                            <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetSortCommand}" CommandParameter="TagCount" GroupName="Sort" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.Sort, 'TagCount'), Mode=OneWay}" Text="Number of tags" />
                            <MenuFlyoutSeparator />
                            <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetSortDirCommand}" CommandParameter="Asc" GroupName="SortDir" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.Direction, 'Asc'), Mode=OneWay}" Text="Ascending" />
                            <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetSortDirCommand}" CommandParameter="Desc" GroupName="SortDir" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.Direction, 'Desc'), Mode=OneWay}" Text="Descending" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem Text="Group by">
                                <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetGroupCommand}" CommandParameter="None" GroupName="GroupBy" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.GroupBy, 'None'), Mode=OneWay}" Text="(None)" />
                                <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetGroupCommand}" CommandParameter="DateTaken" GroupName="GroupBy" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.GroupBy, 'DateTaken'), Mode=OneWay}" Text="Date taken" />
                                <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetGroupCommand}" CommandParameter="DateAdded" GroupName="GroupBy" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.GroupBy, 'DateAdded'), Mode=OneWay}" Text="Date added" />
                                <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetGroupCommand}" CommandParameter="DateModified" GroupName="GroupBy" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.GroupBy, 'DateModified'), Mode=OneWay}" Text="Date modified" />
                                <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetGroupCommand}" CommandParameter="Name" GroupName="GroupBy" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.GroupBy, 'Name'), Mode=OneWay}" Text="Name" />
                                <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetGroupCommand}" CommandParameter="Type" GroupName="GroupBy" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.GroupBy, 'Type'), Mode=OneWay}" Text="Type" />
                                <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetGroupCommand}" CommandParameter="Size" GroupName="GroupBy" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.GroupBy, 'Size'), Mode=OneWay}" Text="Size" />
                                <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetGroupCommand}" CommandParameter="Tags" GroupName="GroupBy" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.GroupBy, 'Tags'), Mode=OneWay}" Text="Tags" />
                                <RadioMenuFlyoutItem Command="{x:Bind Gallery.SetGroupCommand}" CommandParameter="Dimensions" GroupName="GroupBy" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.GroupBy, 'Dimensions'), Mode=OneWay}" Text="Dimensions" />
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE8CB;" />
                </Button>

                <Button x:Name="FilterButton" AutomationProperties.AutomationId="BtnFilter" AutomationProperties.Name="Filter" Style="{StaticResource ChromeIconButtonStyle}">
                    <Button.Flyout>
                        <Flyout Opened="OnFilterOpened">
                            <Grid Width="360">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="10" Padding="0,0,8,12">
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Filters" />
                                        <Expander
                                            Header="{x:Bind Gallery.FilterIncludeHeader, Mode=OneWay}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="8">
                                                <TextBox
                                                    x:Name="FilterIncludeNeedle"
                                                    PlaceholderText="Filter list"
                                                    TextChanged="OnIncludeNeedle" />
                                                <ScrollViewer MaxHeight="200">
                                                    <ItemsRepeater ItemsSource="{x:Bind Gallery.FilterIncludeTags, Mode=OneWay}">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:FilterTagRow">
                                                                <CheckBox
                                                                    Checked="OnFilterCheck"
                                                                    Content="{x:Bind Name, Mode=OneWay}"
                                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                    Tag="{x:Bind Mode=OneWay}"
                                                                    Unchecked="OnFilterCheck" />
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Expander>
                                        <Expander
                                            Header="{x:Bind Gallery.FilterExcludeHeader, Mode=OneWay}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="8">
                                                <TextBox
                                                    PlaceholderText="Filter list"
                                                    TextChanged="OnExcludeNeedle" />
                                                <ScrollViewer MaxHeight="200">
                                                    <ItemsRepeater ItemsSource="{x:Bind Gallery.FilterExcludeTags, Mode=OneWay}">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:FilterTagRow">
                                                                <CheckBox
                                                                    Checked="OnFilterCheck"
                                                                    Content="{x:Bind Name, Mode=OneWay}"
                                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                    Tag="{x:Bind Mode=OneWay}"
                                                                    Unchecked="OnFilterCheck" />
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Expander>
                                        <Expander
                                            Header="{x:Bind Gallery.FilterCharacterHeader, Mode=OneWay}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="8">
                                                <TextBox
                                                    PlaceholderText="Filter list"
                                                    TextChanged="OnCharacterNeedle" />
                                                <ScrollViewer MaxHeight="200">
                                                    <ItemsRepeater ItemsSource="{x:Bind Gallery.FilterCharacterTags, Mode=OneWay}">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:FilterTagRow">
                                                                <CheckBox
                                                                    Checked="OnFilterCheck"
                                                                    Content="{x:Bind Name, Mode=OneWay}"
                                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                    Tag="{x:Bind Mode=OneWay}"
                                                                    Unchecked="OnFilterCheck" />
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Extensions" />
                                        <ItemsRepeater ItemsSource="{x:Bind Gallery.FilterExtensions, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <controls:WrapLayout HorizontalSpacing="8" VerticalSpacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FilterChoice">
                                                    <CheckBox Content="{x:Bind Label, Mode=OneWay}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Folders" />
                                        <ItemsRepeater ItemsSource="{x:Bind Gallery.FilterFolders, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FilterChoice">
                                                    <CheckBox Content="{x:Bind Label, Mode=OneWay}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <Expander Header="Shape" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="8">
                                                <ItemsRepeater ItemsSource="{x:Bind Gallery.FilterOrientations, Mode=OneWay}">
                                                    <ItemsRepeater.Layout>
                                                        <controls:WrapLayout HorizontalSpacing="8" VerticalSpacing="4" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:FilterChoice">
                                                            <CheckBox Content="{x:Bind Label, Mode=OneWay}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Aspect" />
                                                <ItemsRepeater ItemsSource="{x:Bind Gallery.FilterAspects, Mode=OneWay}">
                                                    <ItemsRepeater.Layout>
                                                        <controls:WrapLayout HorizontalSpacing="8" VerticalSpacing="4" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:FilterChoice">
                                                            <CheckBox Content="{x:Bind Label, Mode=OneWay}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="Color" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <ItemsRepeater ItemsSource="{x:Bind Gallery.FilterColors, Mode=OneWay}">
                                                <ItemsRepeater.Layout>
                                                    <controls:WrapLayout HorizontalSpacing="8" VerticalSpacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:FilterChoice">
                                                        <CheckBox Content="{x:Bind Label, Mode=OneWay}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </Expander>
                                        <ComboBox
                                            Header="Date field"
                                            SelectedIndex="{x:Bind Gallery.FilterDateField, Mode=TwoWay}">
                                            <ComboBoxItem Content="Date taken" />
                                            <ComboBoxItem Content="Date added" />
                                            <ComboBoxItem Content="Date modified" />
                                        </ComboBox>
                                        <ComboBox
                                            Header="Date"
                                            SelectedIndex="{x:Bind Gallery.FilterDateMode, Mode=TwoWay}">
                                            <ComboBoxItem Content="Any" />
                                            <ComboBoxItem Content="After" />
                                            <ComboBoxItem Content="Before" />
                                            <ComboBoxItem Content="Exact" />
                                        </ComboBox>
                                        <CalendarDatePicker
                                            Date="{x:Bind Gallery.FilterDate, Mode=TwoWay}"
                                            Header="Day" />
                                    </StackPanel>
                                </ScrollViewer>
                                <Border
                                    Grid.Row="1"
                                    Padding="0,12,0,0"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton Click="OnClearFilters" Content="Clear" />
                                        <Button Grid.Column="1" Click="OnCancelFilters" Content="Cancel" />
                                        <Button
                                            Grid.Column="2"
                                            Click="OnApplyFilters"
                                            Content="Apply"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE71C;" />
                </Button>

                <Button AutomationProperties.AutomationId="BtnLayout" AutomationProperties.Name="Layout" Style="{StaticResource ChromeIconButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem AutomationProperties.AutomationId="MnuLayoutGrid" Command="{x:Bind Gallery.SetLayoutCommand}" CommandParameter="Grid" GroupName="Layout" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.Layout, 'Grid'), Mode=OneWay}" Text="Grid" />
                            <RadioMenuFlyoutItem AutomationProperties.AutomationId="MnuLayoutMasonry" Command="{x:Bind Gallery.SetLayoutCommand}" CommandParameter="Masonry" GroupName="Layout" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.Layout, 'Masonry'), Mode=OneWay}" Text="Masonry" />
                            <RadioMenuFlyoutItem AutomationProperties.AutomationId="MnuLayoutRiver" Command="{x:Bind Gallery.SetLayoutCommand}" CommandParameter="River" GroupName="Layout" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.Layout, 'River'), Mode=OneWay}" Text="River" />
                            <MenuFlyoutSeparator />
                            <RadioMenuFlyoutItem AutomationProperties.AutomationId="MnuDensitySmall" Command="{x:Bind Gallery.SetDensityCommand}" CommandParameter="Small" GroupName="Density" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.Density, 'Small'), Mode=OneWay}" Text="Compact" />
                            <RadioMenuFlyoutItem AutomationProperties.AutomationId="MnuDensityMedium" Command="{x:Bind Gallery.SetDensityCommand}" CommandParameter="Medium" GroupName="Density" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.Density, 'Medium'), Mode=OneWay}" Text="Comfortable" />
                            <RadioMenuFlyoutItem AutomationProperties.AutomationId="MnuDensityLarge" Command="{x:Bind Gallery.SetDensityCommand}" CommandParameter="Large" GroupName="Density" IsChecked="{x:Bind local:GalleryPage.Match(Gallery.Density, 'Large'), Mode=OneWay}" Text="Spacious" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xF0E2;" />
                </Button>

                <Button
                    AutomationProperties.AutomationId="BtnTagUntagged"
                    Command="{x:Bind ViewModel.TagUntaggedCommand}"
                    Content="{x:Bind ViewModel.TagUntaggedLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanTag, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind local:GalleryPage.BoolVis(Gallery.ShowTaggingFilters), Mode=OneWay}" />

                <Button AutomationProperties.AutomationId="BtnMore" AutomationProperties.Name="More" Style="{StaticResource ChromeIconButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Command="{x:Bind Gallery.SelectAllCommand}" Text="Select all" />
                            <MenuFlyoutItem Command="{x:Bind Gallery.SelectNoneCommand}" Text="Select none" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnFindDuplicates" Text="Find duplicates" />
                            <MenuFlyoutItem Click="OnFindSimilar" Text="Find similar" />
                            <MenuFlyoutSeparator Visibility="{x:Bind local:GalleryPage.BoolVis(ViewModel.ShowDirectoryTagging), Mode=OneWay}" />
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.TagFolderUntaggedCommand}"
                                Text="Tag untagged in this folder"
                                Visibility="{x:Bind local:GalleryPage.BoolVis(ViewModel.ShowDirectoryTagging), Mode=OneWay}" />
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.RetagFolderCommand}"
                                Text="Retag all in this folder"
                                Visibility="{x:Bind local:GalleryPage.BoolVis(ViewModel.ShowDirectoryTagging), Mode=OneWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE712;" />
                </Button>

                <ToggleButton
                    AutomationProperties.AutomationId="BtnTogglePreview"
                    AutomationProperties.Name="Preview pane"
                    Command="{x:Bind ViewModel.TogglePreviewCommand}"
                    CornerRadius="4"
                    IsChecked="{x:Bind ViewModel.IsPreviewOpen, Mode=OneWay}"
                    MinHeight="36"
                    MinWidth="40"
                    Padding="8,6"
                    ToolTipService.ToolTip="Preview pane">
                    <FontIcon Glyph="&#xE89F;" />
                </ToggleButton>
            </StackPanel>

            <SelectorBar
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,12,0,0"
                SelectionChanged="OnTaggedFilterChanged"
                Visibility="{x:Bind local:GalleryPage.BoolVis(Gallery.ShowTaggingFilters), Mode=OneWay}">
                <SelectorBarItem IsSelected="True" Text="All" Tag="All" />
                <SelectorBarItem Text="Tagged" Tag="Tagged" />
                <SelectorBarItem Text="Untagged" Tag="Untagged" />
                <SelectorBarItem Text="Failed" Tag="Failed" />
            </SelectorBar>

            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,12,0,0"
                ColumnSpacing="8"
                Visibility="{x:Bind local:GalleryPage.BoolVis(ViewModel.IsTagging), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <ProgressBar
                        AutomationProperties.AutomationId="PrgTagging"
                        Height="4"
                        Maximum="100"
                        Value="{x:Bind ViewModel.TaggingPercent, Mode=OneWay}" />
                    <TextBlock
                        AutomationProperties.AutomationId="TxtTaggingStatus"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind ViewModel.TaggingMessage, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="BtnCancelTagging"
                    Command="{x:Bind ViewModel.CancelTaggingCommand}"
                    Content="Cancel" />
            </Grid>
        </Grid>

        <Grid x:Name="TileHost" Grid.Row="1" PointerWheelChanged="OnGalleryWheel" SizeChanged="OnTileHostSizeChanged">
            <Border
                Canvas.ZIndex="10"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="{x:Bind local:GalleryPage.BoolVis(ViewModel.IsLibraryLoading), Mode=OneWay}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <ProgressRing
                        Width="48"
                        Height="48"
                        IsActive="{x:Bind ViewModel.IsLibraryLoading, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.LoadingMessage, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind local:GalleryPage.EmptyVis(Gallery.IsEmpty, Gallery.HasLibraries, ViewModel.IsLibraryLoading), Mode=OneWay}">
                <FontIcon FontSize="48" Glyph="&#xE8B7;" />
                <TextBlock AutomationProperties.AutomationId="TxtEmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="Add a folder to start" />
                <TextBlock
                    MaxWidth="420"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Seiri will scan images and videos, read sidecar .txt tags, and keep thumbs in a thumbnail folder inside that directory."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.AutomationId="BtnAddFolderEmpty"
                    Click="OnEmptyAddFolder"
                    Content="Add folder"
                    Style="{StaticResource AccentButtonStyle}" />
                <HyperlinkButton
                    AutomationProperties.AutomationId="BtnDemoFolder"
                    Click="OnUseDemoFolder"
                    Content="Use a demo folder" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind local:GalleryPage.NoMatchVis(Gallery.IsEmpty, Gallery.HasLibraries, ViewModel.IsLibraryLoading), Mode=OneWay}">
                <FontIcon FontSize="48" Glyph="&#xE721;" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind local:GalleryPage.EmptyMatchTitle(Gallery.ShowTaggingFilters, Gallery.TaggedFilter), Mode=OneWay}" />
                <HyperlinkButton Command="{x:Bind Gallery.ClearSearchCommand}" Content="Clear search" />
            </StackPanel>

            <Grid Visibility="{x:Bind local:GalleryPage.GalleryVis(Gallery.IsEmpty), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollView
                    x:Name="GalleryScroll"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Disabled"
                    Loaded="OnGalleryScrollLoaded"
                    SizeChanged="OnGalleryScrollSizeChanged"
                    ViewChanged="OnGalleryViewChanged"
                    VerticalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Enabled">
                    <ItemsRepeater
                        x:Name="GalleryRepeater"
                        ElementClearing="OnElementClearing"
                        ItemTemplate="{StaticResource GallerySelector}"
                        ItemsSource="{x:Bind Gallery.Entries, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <layouts:GalleryVirtualizingLayout
                                x:Name="GalleryLayout"
                                MasonryColumnWidth="{x:Bind Gallery.MasonryColumnWidth, Mode=OneWay}"
                                Mode="{x:Bind Gallery.Layout, Mode=OneWay}"
                                RiverRowHeight="{x:Bind Gallery.RiverRowHeight, Mode=OneWay}"
                                Spacing="8"
                                TileSize="{x:Bind TileSize, Mode=OneWay}" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollView>
                <AnnotatedScrollBar
                    x:Name="IndexBar"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    AutomationProperties.AutomationId="GalleryIndexBar"
                    DetailLabelRequested="OnIndexBarDetail"
                    Visibility="{x:Bind local:GalleryPage.BoolVis(Gallery.ShowIndexBar), Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
